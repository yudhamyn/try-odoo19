<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Privilege -->
        <record model="res.groups.privilege" id="res_groups_privilege_todo">
            <field name="name">Todo &amp; Tasks</field>
            <field name="sequence">25</field>
            <field name="category_id" ref="base.module_category_productivity"/>
        </record>

        <!-- Groups: Todo -->
        <record id="group_todo_user" model="res.groups">
            <field name="name">User</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_todo"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_todo_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_todo"/>
            <field name="implied_ids" eval="[(4, ref('group_todo_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
